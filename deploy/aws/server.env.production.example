# ==============================================================================
# STARVNT - Production Server Environment Configuration (AWS)
# ==============================================================================
# Copy this file to .env on your AWS EC2/Lightsail host.
# NEVER commit your actual .env with secret keys to version control.

NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Allow all StarVnt subdomains (Customer, Vendor, Admin) and primary domain
CLIENT_ORIGINS=https://starvnt.com,https://www.starvnt.com,https://customer.starvnt.com,https://customers.starvnt.com,https://vendor.starvnt.com,https://partner.starvnt.com,https://admin.starvnt.com
COOKIE_SECURE=true
# Set cookieDomain to root domain so session cookies work seamlessly across subdomains:
COOKIE_DOMAIN=.starvnt.com

# ------------------------------------------------------------------------------
# DUAL-DOMAIN DATABASE CONNECTIONS (MongoDB Atlas - AWS Mumbai ap-south-1)
# ------------------------------------------------------------------------------
# Provisioned on MongoDB Atlas inside AWS Mumbai region for lowest latency (<5ms)
MONGO_URI_EXTERNAL=mongodb+srv://starvnt_app_user:<STRONG_DB_PASSWORD>@starvnt-cluster.xxxx.mongodb.net/starvnt_external?retryWrites=true&w=majority
MONGO_URI_ADMIN=mongodb+srv://starvnt_admin_user:<STRONG_DB_PASSWORD>@starvnt-cluster.xxxx.mongodb.net/starvnt_admin?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (DUAL-DOMAIN JWT SECRETS)
# ------------------------------------------------------------------------------
# Generate distinct 64-char cryptographically secure keys: openssl rand -hex 32
JWT_EXTERNAL_SECRET=<GENERATE_STRONG_RANDOM_HEX_64_CHARS_FOR_EXTERNAL>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

JWT_ADMIN_SECRET=<GENERATE_DIFFERENT_STRONG_RANDOM_HEX_64_CHARS_FOR_ADMIN>
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_AUTH_RATE_LIMIT=10
ADMIN_MFA_REQUIRED_FOR_SUPER_ADMIN=true
ADMIN_MFA_ISSUER=STARVNT Core

BCRYPT_ROUNDS=12
INTERNAL_API_KEY=<GENERATE_STRONG_RANDOM_HEX_64_CHARS_FOR_OPS_GATEWAY>

# ------------------------------------------------------------------------------
# SUPER ADMIN BOOTSTRAP (For initial seed on AWS)
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME=StarVnt System Administrator
SUPER_ADMIN_EMAIL=admin@starvnt.com
SUPER_ADMIN_PASSWORD=<STRONG_BOOTSTRAP_PASSWORD_MIN_12_CHARS>

# ------------------------------------------------------------------------------
# AURA+ AI ENGINE (Google Gemini / AWS Bedrock)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=<YOUR_GOOGLE_AI_STUDIO_API_KEY>
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_LEVEL=minimal
AURA_REASONING_MODEL=gemini-2.5-flash
AURA_REASONING_LEVEL=low
CHAT_THINKING_STATUS_DELAY_MS=1200
CHAT_STATUS_ROTATION_MS=2500

# ------------------------------------------------------------------------------
# EMAIL & NOTIFICATIONS (Amazon SES or SMTP/Resend)
# ------------------------------------------------------------------------------
# Option 1: Amazon SES (Recommended on AWS - 62,000 free emails/mo from EC2)
EMAIL_SERVER_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=<YOUR_SES_SMTP_USERNAME>
EMAIL_SERVER_PASSWORD=<YOUR_SES_SMTP_PASSWORD>
EMAIL_FROM=notifications@starvnt.com

# Option 2: Resend (Alternative fallback)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=notifications@starvnt.com

# ------------------------------------------------------------------------------
# SMS & PHONE OTP (MSG91 - India DLT Compliant)
# ------------------------------------------------------------------------------
MSG91_AUTHKEY=<YOUR_MSG91_AUTH_KEY>
MSG91_OTP_TEMPLATE_ID=<YOUR_APPROVED_DLT_TEMPLATE_ID>
MSG91_SENDER_ID=STRVNT
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# ------------------------------------------------------------------------------
# PAYMENTS (Razorpay Production / Live Keys)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_<YOUR_KEY_ID>
RAZORPAY_KEY_SECRET=<YOUR_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>

# ------------------------------------------------------------------------------
# VERIFICATION SERVICES (GSTIN / PAN / Bank Account)
# ------------------------------------------------------------------------------
GSTIN_API_KEY=<YOUR_GSTIN_API_KEY>
GSTIN_API_BASE_URL=https://www.gstinapi.in/v1

PAN_API_KEY=<YOUR_PAN_API_KEY>
PAN_API_BASE_URL=https://www.gstinapi.in/v1
PAN_MOCK_ENABLED=false

BANK_VERIFICATION_PROVIDER=CASHFREE
BANK_VERIFICATION_MOCK_ENABLED=false
CASHFREE_CLIENT_ID=<YOUR_CASHFREE_PROD_APP_ID>
CASHFREE_CLIENT_SECRET=<YOUR_CASHFREE_PROD_SECRET>
CASHFREE_BAV_BASE_URL=https://api.cashfree.com

# ------------------------------------------------------------------------------
# GOOGLE APIS (OAuth & Location Services)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_PLACES_API_KEY=<YOUR_SERVER_RESTRICTED_GOOGLE_MAPS_KEY>

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudinary or AWS S3 Bucket)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_CLOUDINARY_API_SECRET>

# ------------------------------------------------------------------------------
# WORKERS & SAFETY GATES
# ------------------------------------------------------------------------------
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=15000
RESERVATION_EXPIRY_WORKER_ENABLED=true
RESERVATION_EXPIRY_INTERVAL_MS=60000
METRICS_ENABLED=true
REQUEST_LOGGING_ENABLED=true
ENABLE_QA_PAYMENT_BYPASS=false
ENABLE_DEV_TOOLS=false

# Financial commissions
PLATFORM_COMMISSION_PERCENT=10
TDS_PERCENT=1
GST_PERCENT=18
