# ==============================================================================
# STARVNT - Production Web Frontend Environment Configuration (AWS)
# ==============================================================================
# Used when building the Vite frontend bundle for deployment to AWS S3 / CloudFront

# Production API Endpoint (points to the AWS backend domain)
VITE_API_URL=https://api.starvnt.com

# Google OAuth Client ID for Customer & Vendor logins
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com

# Razorpay Key ID for client-side checkout modal
VITE_RAZORPAY_KEY_ID=rzp_live_<YOUR_RAZORPAY_KEY_ID>

# Google Maps Javascript API Key for frontend maps and address autocomplete
VITE_GOOGLE_MAPS_API_KEY=<YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY>

# MSG91 Widget Configuration (optional)
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=

# Disable developer POV test shortcuts on production build
VITE_ENABLE_DEV_TOOLS=false
