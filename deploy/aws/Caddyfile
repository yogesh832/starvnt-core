vendor.starvnt.com {
  encode gzip
  request_body {
    max_size 25MB
  }
  header X-Content-Type-Options nosniff
  handle /api/* {
    reverse_proxy backend:4000 {
      flush_interval -1
    }
  }
  handle /assets/* {
    root * /srv
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    file_server
  }
}

app.starvnt.com {
  request_body {
    max_size 25MB
  }
  # Public policy routes and the static files needed to render them.
  @publicWeb path /privacy /privacy/ /privacy-policy /privacy-policy/ /assets/* /brand/* /deployment.json
  handle @publicWeb {
    root * /srv
    try_files {path} /index.html
    header Cache-Control "no-cache"
    header X-Content-Type-Options nosniff
    file_server
  }
  handle {
    reverse_proxy backend:4000 {
      flush_interval -1
    }
  }
}
