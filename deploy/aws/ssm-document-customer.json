{
  "schemaVersion": "2.2",
  "description": "Deploy an exact STARVNT customer commit using the installed production deployment script",
  "parameters": {
    "CommitSha": {
      "type": "String",
      "description": "Full Git commit SHA tested by GitHub Actions",
      "allowedPattern": "^[0-9a-f]{40}$",
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [{
    "action": "aws:runShellScript",
    "name": "deployCustomer",
    "inputs": {
      "timeoutSeconds": "1100",
      "runCommand": [
        "set -eu",
        "exec /opt/starvnt/bin/deploy-customer \"$SSM_CommitSha\""
      ]
    }
  }]
}
