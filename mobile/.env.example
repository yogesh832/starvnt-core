# Public configuration only. Never copy server secrets here.
# Android emulator: http://10.0.2.2:4000; iOS simulator: http://localhost:4000.
# Physical devices: the development computer's LAN address; production: HTTPS.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Same WEB client ID as server GOOGLE_CLIENT_ID (native SDK requests this audience).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.<id>
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
