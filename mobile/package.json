{
  "name": "@starvnt/mobile",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "scripts": {
    "sync:brand": "node scripts/sync-brand.mjs",
    "prestart": "npm run sync:brand",
    "preweb": "npm run sync:brand",
    "preandroid": "npm run sync:brand",
    "preios": "npm run sync:brand",
    "preexport": "npm run sync:brand",
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:dashboards": "node --experimental-strip-types scripts/dashboard-qa.mjs",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.3",
    "expo-constants": "~58.0.9",
    "expo-crypto": "~58.0.3",
    "expo-dev-client": "~58.0.9",
    "expo-device": "~58.0.3",
    "expo-document-picker": "~58.0.3",
    "expo-file-system": "~58.0.4",
    "expo-font": "~58.0.4",
    "expo-image": "~58.0.8",
    "expo-notifications": "~58.0.9",
    "expo-secure-store": "~58.0.1",
    "expo-sharing": "~58.0.12",
    "expo-splash-screen": "~58.0.2",
    "expo-system-ui": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
