{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "STARVNT unified backend — one server hosting both identity domains: EXTERNAL (Customer/Vendor) auth and INTERNAL (Admin/Super Admin) auth with RBAC, each backed by its own MongoDB database.",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "seed": "node scripts/seed-super-admin.js",
    "seed:vendor": "node scripts/seed-vendor.js",
    "seed:customer-demo": "node scripts/seed-customer-demo.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.21.0",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  }
}
