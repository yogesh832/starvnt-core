# ── STARVNT Unified Server ──────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# For production subdomains, use COOKIE_SECURE=true and usually .starvnt.com
# COOKIE_DOMAIN=.starvnt.com
BCRYPT_ROUNDS=12

# ── Dual MongoDB Topology (Separate Auth & Tenant Databases) ───────────────
DATABASE_URL=mongodb://localhost:27017/starvntCore
MONGO_URI_EXTERNAL=mongodb://localhost:27017/starvnt_external
MONGO_URI_ADMIN=mongodb://localhost:27017/starvnt_admin

# ── EXTERNAL Domain (Customers + Vendors) ───────────────────────────────────
JWT_EXTERNAL_SECRET=your-external-jwt-secret
ACCESS_TOKEN_TTL=2d
REFRESH_TOKEN_TTL_DAYS=2

# ── INTERNAL ADMIN Domain (Strict Isolation) ────────────────────────────────
JWT_ADMIN_SECRET=your-admin-jwt-secret-different-from-external
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL_DAYS=7
ADMIN_AUTH_RATE_LIMIT=10

# ── Super Admin Bootstrap ──────────────────────────────────────────────────
SUPER_ADMIN_NAME=STARVNT Super Admin
SUPER_ADMIN_EMAIL=superadmin@starvnt.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ── Cloudinary Media CDN ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Google OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_DISTANCE_MATRIX_API_KEY=your-google-distance-matrix-api-key

# ── MSG91 OTP Gateway ─────────────────────────────────────────────────────
MSG91_AUTHKEY=your-msg91-authkey
MSG91_OTP_TEMPLATE_ID=your-approved-msg91-otp-template-id

# ── Email OTP SMTP ────────────────────────────────────────────────────────
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-smtp-email@example.com
EMAIL_SERVER_PASSWORD=your-smtp-app-password
EMAIL_FROM=your-smtp-email@example.com

# ── Email OTP via Resend (optional) ───────────────────────────────────────
# If enabled, Resend is attempted first. Keep disabled locally when SMTP is preferred.
# RESEND_KEY=your-resend-api-key
# RESEND_API_KEY=your-resend-api-key
# RESEND_SENDER_EMAIL=no-reply@starvnt.com

# ── Razorpay Test Payments ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── GSTIN Verification ────────────────────────────────────────────────────
GSTIN_API_KEY=your-gstinapi-key
GSTIN_API_BASE_URL=https://www.gstinapi.in/v1

# ── Corporate PAN Verification (Optional) ──────────────────────────────────
# Defaults to GSTIN_API_KEY and GSTIN_API_BASE_URL if not specified
PAN_API_KEY=your-pan-or-gstin-api-key
PAN_API_BASE_URL=https://www.gstinapi.in/v1
# PAN_MOCK_ENABLED=true

# ── Render production keep-alive ──────────────────────────────────────────
# Only runs when NODE_ENV=production. Use your Render backend URL.
KEEP_ALIVE_URL=https://your-backend.onrender.com
KEEP_ALIVE_INTERVAL_MS=10000
