# Copy to server/.env.test.local. Load with STARVNT_ENV_FILE; never use live data.
NODE_ENV=test
PORT=4100
CLIENT_ORIGINS=http://localhost:5174
COOKIE_SECURE=false
COOKIE_DOMAIN=
MONGO_URI_EXTERNAL=mongodb://127.0.0.1:27018/starvnt_test_external
MONGO_URI_ADMIN=mongodb://127.0.0.1:27018/starvnt_test_admin
QA_ALLOW_REMOTE_DATABASE=false
JWT_EXTERNAL_SECRET=local-qa-external-only-change-before-any-shared-environment
JWT_ADMIN_SECRET=local-qa-admin-only-change-before-any-shared-environment
REFRESH_COOKIE_NAME=starvnt_qa_ext_rt
ADMIN_REFRESH_COOKIE_NAME=starvnt_qa_admin_rt
ADMIN_MFA_REQUIRED_FOR_SUPER_ADMIN=false
ENABLE_DEV_TOOLS=true
ENABLE_QA_PAYMENT_BYPASS=false
OUTBOX_WORKER_ENABLED=false
RESERVATION_EXPIRY_WORKER_ENABLED=false
METRICS_ENABLED=false
REQUEST_LOGGING_ENABLED=false
# Optional provider tests: configure test keys locally. No live keys are needed.
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
INTERNAL_API_KEY=local-qa-only
